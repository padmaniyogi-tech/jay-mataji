# ---------------------------------------------------------------------------
# Amplifi — environment template. Copy to .env.local for local development.
# NEVER commit a filled-in .env file. Secrets belong in your host's secret store.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
APP_NAME=Amplifi
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database ------------------------------------------------------------------
# Leave DATABASE_URL empty locally to use the bundled PGlite file database
# (single-writer, for development and tests only).
# Production: a managed Postgres connection string, e.g. from Supabase/Neon/RDS.
# DATABASE_URL=postgresql://user:password@host:5432/amplifi?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10
PGLITE_DATA_DIR=.data/pglite

# Secrets -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-32-byte-random-string
ENCRYPTION_KEY=replace-me-with-32-byte-base64-key
# Protects POST /api/cron/tick (Bearer token or ?secret=)
CRON_SECRET=replace-me-with-another-random-string

# Payments ------------------------------------------------------------------
# mock  = no money moves; simulates the gateway through the same verification path
# razorpay = real Razorpay test/live keys
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email ---------------------------------------------------------------------
# console = writes .eml files to .data/mail (development only)
# smtp    = any SMTP provider (Resend/SES/Postmark/SMTP relay)
EMAIL_PROVIDER=console
EMAIL_FROM=Amplifi <no-reply@amplifi.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Provider integrations (all optional; adapters stay "unconfigured" until set) 
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
AGENCY_BASE_URL=
AGENCY_API_KEY=
AGENCY_WEBHOOK_SECRET=

# Demo / development --------------------------------------------------------
# DEMO_MODE must be false (or unset) for any production deployment.
DEMO_MODE=true
DEMO_AUTO_VERIFY_EMAIL=true
# Runs the queue worker inside `next dev` (never in production).
INLINE_WORKER=true
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=5
